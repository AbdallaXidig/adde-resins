# --- Required ---
# Local: `npm run db:local` serves this exact URL. Production: your managed PostgreSQL URL.
DATABASE_URL="postgresql://adde:adde_local_dev@localhost:5433/adde_resins"
# At least 32 random characters: `openssl rand -base64 48`
AUTH_SECRET=""
# Public site address, used in SEO metadata, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# --- First administrator, created by `npm run db:seed` ---
ADMIN_EMAIL="admin@addeinternational.com"
ADMIN_PASSWORD=""

# --- Optional: email notifications for new RFQs, orders and inquiries ---
# Leave SMTP_HOST empty to skip sending. Submissions are always saved in the database.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Adde International <no-reply@addeinternational.com>"
NOTIFY_EMAIL="info@addeinternational.com"

# --- Optional: where admin-uploaded images are stored (use a persistent volume in production) ---
UPLOAD_DIR="./uploads"

# --- Optional: online payments. "none" keeps checkout as order submission with staff follow-up ---
PAYMENT_PROVIDER="none"
